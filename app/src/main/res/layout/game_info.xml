<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/board_margin">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchVsAi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="switchVsAiClicked"
            android:text="@string/mode_vs_ai"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <RadioGroup
            android:id="@+id/radioGroupStarter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/info_spacing"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/switchVsAi">

            <RadioButton
                android:id="@+id/radioButtonStarterX"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/starter_x" />

            <RadioButton
                android:id="@+id/radioButtonStarterO"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/info_spacing"
                android:text="@string/starter_o" />
        </RadioGroup>

        <TextView
            android:id="@+id/textViewStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/info_spacing"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/radioGroupStarter" />

        <Chronometer
            android:id="@+id/chronometerGameTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/info_spacing"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewStatus" />

        <Button
            android:id="@+id/buttonNewGame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/info_spacing"
            android:onClick="buttonNewGameClicked"
            android:text="@string/new_game"
            app:layout_constraintEnd_toStartOf="@+id/buttonUndo"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/chronometerGameTime" />

        <Button
            android:id="@+id/buttonUndo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/info_spacing"
            android:onClick="buttonUndoClicked"
            android:text="@string/undo"
            app:layout_constraintBaseline_toBaselineOf="@+id/buttonNewGame"
            app:layout_constraintEnd_toStartOf="@+id/buttonRotateBoard"
            app:layout_constraintStart_toEndOf="@+id/buttonNewGame" />

        <Button
            android:id="@+id/buttonRotateBoard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/info_spacing"
            android:onClick="buttonRotateBoardClicked"
            android:text="@string/rotate_board"
            app:layout_constraintBaseline_toBaselineOf="@+id/buttonNewGame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/buttonUndo" />

        <Button
            android:id="@+id/buttonBoardSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="buttonBoardSettingsClicked"
            android:text="@string/board_settings"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/buttonStatistics"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/buttonNewGame" />

        <Button
            android:id="@+id/buttonStatistics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/info_spacing"
            android:onClick="buttonStatisticsClicked"
            android:text="@string/statistics"
            app:layout_constraintBaseline_toBaselineOf="@+id/buttonBoardSettings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/buttonBoardSettings" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
