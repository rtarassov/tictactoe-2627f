<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/board_margin">

    <TextView
        android:id="@+id/textViewLabelRows"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/board_settings_rows"
        app:layout_constraintEnd_toStartOf="@+id/textViewLabelColumns"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewLabelColumns"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/board_settings_columns"
        app:layout_constraintEnd_toStartOf="@+id/textViewLabelWinLength"
        app:layout_constraintStart_toEndOf="@+id/textViewLabelRows"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewLabelWinLength"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/board_settings_win_length"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/textViewLabelColumns"
        app:layout_constraintTop_toTopOf="parent" />

    <NumberPicker
        android:id="@+id/numberPickerRows"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/textViewLabelRows"
        app:layout_constraintStart_toStartOf="@+id/textViewLabelRows"
        app:layout_constraintTop_toBottomOf="@+id/textViewLabelRows" />

    <NumberPicker
        android:id="@+id/numberPickerColumns"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/textViewLabelColumns"
        app:layout_constraintStart_toStartOf="@+id/textViewLabelColumns"
        app:layout_constraintTop_toBottomOf="@+id/textViewLabelColumns" />

    <NumberPicker
        android:id="@+id/numberPickerWinLength"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/textViewLabelWinLength"
        app:layout_constraintStart_toStartOf="@+id/textViewLabelWinLength"
        app:layout_constraintTop_toBottomOf="@+id/textViewLabelWinLength" />

</androidx.constraintlayout.widget.ConstraintLayout>
